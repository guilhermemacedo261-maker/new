# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# NFL DATA (ESPN public scoreboard API - sem chave necessaria)
# ============================================================
NFL_API_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl
NFL_API_KEY=

# ============================================================
# WHATSAPP (Evolution API por padrao - ver src/lib/whatsapp)
# ============================================================
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=
WHATSAPP_DESTINATION=
WHATSAPP_GROUP_ID=

# ============================================================
# ADMIN (login simples por senha para o painel /admin)
# ============================================================
ADMIN_PASSWORD=

# Chave usada para assinar cookies de sessao (participante e admin).
# Gere uma string aleatoria longa, ex: openssl rand -hex 32
SESSION_SECRET=

# Chave usada para proteger as rotas /api/cron/* de chamadas externas
# (Vercel Cron envia este header automaticamente quando configurado em vercel.json)
CRON_SECRET=

# URL publica da aplicacao (usada pelos scripts de cron e pela geracao de imagem)
APP_URL=http://localhost:3000

# Ano/temporada atual (fallback caso a API da NFL nao informe)
NEXT_PUBLIC_CURRENT_SEASON=2026
